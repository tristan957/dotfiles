#!/usr/bin/env python3

import argparse
import os
import re
import select
import subprocess
import sys
import termios
import tty
from enum import StrEnum
from typing import TYPE_CHECKING, cast

if TYPE_CHECKING:

    class Args(argparse.Namespace):
        timeout: float


class Mode(StrEnum):
    DARK = "dark"
    LIGHT = "light"

RESPONSE_RE = re.compile(rb"rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)")


def query_background_color(tty_fd: int, timeout: float) -> bytes:
    """
    Send the OSC 11 query and read the raw response from the terminal.
    """

    os.write(tty_fd, b"\033]11;?\033\\")

    response = b""
    while True:
        ready, _, _ = select.select([tty_fd], [], [], timeout)
        if not ready:
            break
        chunk = os.read(tty_fd, 1)
        if not chunk:
            break
        response += chunk
        if response.endswith(b"\a") or response.endswith(b"\033\\"):
            break
    return response


def detect_background(timeout: float) -> Mode | None:
    """
    Return Mode.DARK or Mode.LIGHT, or None if the terminal didn't respond.
    """

    try:
        tty_fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        return None

    try:
        old_settings = termios.tcgetattr(tty_fd)
    except termios.error:
        os.close(tty_fd)
        return None

    try:
        tty.setraw(tty_fd)
        response = query_background_color(tty_fd, timeout)
    finally:
        termios.tcsetattr(tty_fd, termios.TCSADRAIN, old_settings)
        os.close(tty_fd)

    match = RESPONSE_RE.search(response)
    if not match:
        return None

    r, g, b = (int(component[:2], 16) for component in match.groups())
    # Perceived luminance (ITU-R BT.601).
    luminance = (r * 299 + g * 587 + b * 114) / 1000

    return Mode.DARK if luminance < 128 else Mode.LIGHT


def platform_appearance() -> Mode | None:
    """
    Fall back to the OS-wide appearance setting, or None if it can't be
    determined.
    """

    match sys.platform:
        case "darwin":
            try:
                proc = subprocess.run(
                    ["defaults", "read", "-g", "AppleInterfaceStyle"],
                    capture_output=True,
                    text=True,
                    timeout=1,
                )
            except (OSError, subprocess.TimeoutExpired):
                return None

            if proc.returncode != 0:
                return None

            return Mode.DARK if proc.stdout.strip().lower() == str(Mode.DARK) else Mode.LIGHT
        case _:
            return None


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            'Print "dark" or "light" based on the terminal\'s actual '
            "background color, queried via the OSC 11 escape sequence. "
            "Falls back to the OS-wide appearance setting. Exits with a "
            "non-zero code if the appearance mode cannot be determined."
        )
    )
    parser.add_argument(
        "-t",
        "--timeout",
        type=float,
        default=0.5,
        help="seconds to wait for each byte of the terminal's response (default: 0.5)",
    )
    args = cast("Args", parser.parse_args())

    result = detect_background(args.timeout)
    if result is None:
        result = platform_appearance()

    print(result)

    return 0


if __name__ == "__main__":
    sys.exit(main())
