{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/react",
		"types": ["bun"],
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["*.ts", "*.tsx"]
}
