# Terminal-palette styleset that works on light and dark backgrounds.
#
# Rules:
#   - Never use palette 0, 7 or 15; they don't flip with light/dark themes.
#   - Text uses the terminal default fg. Emphasis is bold, de-emphasis is dim.
#   - Neutral fills use bg 8 with the default fg.
#   - Colored fills use fg <color> + reverse, so text takes the terminal bg.
#   - 4 (blue) is the accent. 3 and 6 are weak on light themes; use sparingly.

*.default = true
*.normal = true

*error.bold = true
*error.fg = 1
*warning.bold = true
*warning.fg = 3
*success.bold = true
*success.fg = 2

*.selected.bg = 8
*.selected.bold = true

border.fg = 8

completion_default.bg = 8
completion_default.selected.bg = default
completion_default.selected.fg = 4
completion_default.selected.reverse = true
